<Window x:Class="PyBro.UI.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStyle="None" ResizeMode="NoResize"
        Title="Ghid de Utilizare PyBro" Height="400" Width="500"
        Background="#1e1e1e" WindowStartupLocation="CenterOwner">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="HelpCircle" Foreground="#858ae3" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="HELP" Foreground="#858ae3" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Name="btnCloseHelp" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="btnCloseHelp_Click">
                <iconPacks:PackIconMaterial Kind="Close" Foreground="#D4D4D4" Width="15" Height="15"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel TextElement.Foreground="#D4D4D4" 
                        TextElement.FontFamily="Consolas" 
                        TextElement.FontSize="13">
                <TextBlock Text="1. Rularea unui script" FontWeight="Bold" Foreground="White" Margin="0,5,0,2"/>
                <TextBlock Text="Scrie codul Python în editorul central, apoi apasă butonul cu iconița 'Play' pentru a-l executa. Rezultatul va apărea jos, în consolă." TextWrapping="Wrap" Margin="0,0,0,15"/>

                <TextBlock Text="2. Salvarea și Încărcarea" FontWeight="Bold" Foreground="White" Margin="0,5,0,2"/>
                <TextBlock Text="Folosește butoanele de 'Save' și 'Load' din bara de unelte pentru a gestiona scripturile tale (.py)." TextWrapping="Wrap" Margin="0,0,0,15"/>

                <TextBlock Text="3. Exploratorul de fișiere" FontWeight="Bold" Foreground="White" Margin="0,5,0,2"/>
                <TextBlock Text="Apasă pe 'Selectează folderul' pentru a deschide un spațiu de lucru. Poți naviga prin foldere și deschide fișierele cu un singur click." TextWrapping="Wrap" Margin="0,0,0,15"/>

                <TextBlock Text="PyBro IDE v1.0" FontSize="10" Foreground="#555" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>