<Application x:Class="UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UI"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="EditorBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ToolbarBg" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
        <SolidColorBrush x:Key="MainText" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#858ae3"/>
    </Application.Resources>
</Application>

    