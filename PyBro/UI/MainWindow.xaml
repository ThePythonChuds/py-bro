<Window x:Class="PyBro.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
		WindowStyle="None" 
        Title="PyBro IDE - Test Version" Height="600" Width="900"
        Background="#1e1e1e">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>


    <Window.Resources>
        <SolidColorBrush x:Key="EditorBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ToolbarBg" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
        <SolidColorBrush x:Key="MainText" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#858ae3"/>

        
            <Style x:Key="FlatButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ButtonBg}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" 
                 Background="{TemplateBinding Background}" 
                 BorderBrush="{TemplateBinding BorderBrush}" 
                 BorderThickness="{TemplateBinding BorderThickness}" 
                 CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B51919"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="1" Background="{StaticResource ToolbarBg}" Margin="5" MouseLeftButtonDown="Window_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Name="btnRun" Margin="5" Width="35" Height="30" Background="{StaticResource ButtonBg}" Foreground="White" Click="btnRun_Click">
                    <iconPacks:PackIconMaterial Kind="Play" Width="15" Height="15"/>
                </Button>
                <Button Name="btnSave" Margin="5" Width="35" Height="30" Background="{StaticResource ButtonBg}" Foreground="White" Click="btnSave_Click">
                    <iconPacks:PackIconMaterial Kind="ContentSave" Width="15" Height="15"/>
                </Button>
                <Button Name="btnLoad" Margin="5" Width="35" Height="30" Background="{StaticResource ButtonBg}" Foreground="White" Click="btnLoad_Click">
                    <iconPacks:PackIconMaterial Kind="Upload" Width="15" Height="15"/>
                </Button>
                <Button Name="btnHelp" Margin="5" Width="35" Height="30" Background="{StaticResource ButtonBg}" Foreground="White" >
                    <iconPacks:PackIconMaterial Kind="Helicopter" Width="15" Height="15" Spin="True"/>
                </Button>
                <Button Name="btnLoadPath" Margin="5" Width="35" Height="30" Background="{StaticResource ButtonBg}" Foreground="White" Click="btnLoadPath_Click">
                    <iconPacks:PackIconMaterial Kind="Folder" Width="15" Height="15"/>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Name="btnMinimize" Width="30" Style="{StaticResource FlatButtonStyle}" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" Click="btnMinimize_Click">
                    <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="9" Height="40" HorizontalAlignment="Center"/>
                </Button>
                <Button Name="btnClose" Width="30" Style="{StaticResource CloseButtonStyle}" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" Click="btnClose_Click">
                    <iconPacks:PackIconMaterial Kind="WindowClose" Width="8" Height="8"/>
                </Button>
            </StackPanel>
        </Grid>

        <TextBox Name="txtEditor" Grid.Row="1" Grid.Column="1"
                 AcceptsReturn="True" AcceptsTab="True" 
                 Margin="5,0,0,0"
                 FontFamily="Consolas" FontSize="14"
                 Background="{StaticResource EditorBg}" Foreground="#d4d4d4" 
                 BorderThickness="0" VerticalScrollBarVisibility="Auto"/>

        <GridSplitter Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Height="5" HorizontalAlignment="Stretch" Background="#333"/>


        <TreeView x:Name="fileExplorer" 
          SelectedItemChanged="fileExplorer_SelectedItemChanged"
          Grid.Column="0" 
          Grid.Row="0"
          Grid.RowSpan="2"
          Background="#252526" 
          Foreground="White" 
          BorderThickness="0">
            
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="{Binding IconKind}" 
                                        Width="16" Height="16" 
                                        Margin="0,0,5,0" 
                                        Foreground="{Binding IconColor}"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>

        </TreeView>

        <TextBox Name="txtConsole" Grid.Row="3" 
                 IsReadOnly="True" 
                 Grid.ColumnSpan="2"
                 Background="#4e148c" Foreground="{StaticResource MainText}" 
                 FontFamily="Consolas" BorderThickness="0"
                 VerticalScrollBarVisibility="Auto"
                 Text="PyBro Console v1.0 - Ready..."/>
    </Grid>
</Window>
