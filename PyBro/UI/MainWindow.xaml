<Window x:Class="PyBro.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="PyBro IDE - Test Version" Height="600" Width="900"
        Background="#1e1e1e">

    <Window.Resources>
        <SolidColorBrush x:Key="EditorBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ToolbarBg" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
        <SolidColorBrush x:Key="MainText" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#858ae3"/>
    </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Background="{StaticResource ToolbarBg}" Margin="5">

            <Button Name="btnRun" Margin="5" Width="35" Height="30" Background="{StaticResource ButtonBg}" Foreground="White" Click="btnRun_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Play" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,0,0"/>
                </StackPanel>
            </Button>
            
            <Button Name="btnSave" Margin="5" Width="35" Height="30" Background="{StaticResource ButtonBg}" Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ContentSave" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,0,0"/>
                    
                </StackPanel>
            </Button>

            <Button Name="btnHelp" Margin="5" Width="35" Height="30" Background="{StaticResource ButtonBg}" Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Helicopter" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,0,0"/>
                </StackPanel>
            </Button>

        </StackPanel>

        <TextBox Name="txtEditor" Grid.Row="1" Grid.Column="1"
                 AcceptsReturn="True" AcceptsTab="True" 
                 Margin="5,0,0,0"
                 FontFamily="Consolas" FontSize="14"
                 Background="{StaticResource EditorBg}" Foreground="#d4d4d4" 
                 BorderThickness="0" VerticalScrollBarVisibility="Auto"/>

        <GridSplitter Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Height="5" HorizontalAlignment="Stretch" Background="#333"/>

        <TreeView Name="fileExplorer" 
          Grid.Column="0" 
          Grid.Row="0"
          Grid.RowSpan="2"
          Background="#252526" 
          Foreground="White" 
          BorderThickness="0">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="{Binding IconKind}" 
                                        Width="16" Height="16" 
                                        Margin="0,0,5,0" 
                                        Foreground="{Binding IconColor}"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>

        </TreeView>

        <TextBox Name="txtConsole" Grid.Row="3" 
                 IsReadOnly="True" 
                 Grid.ColumnSpan="2"
                 Background="#4e148c" Foreground="{StaticResource MainText}" 
                 FontFamily="Consolas" BorderThickness="0"
                 VerticalScrollBarVisibility="Auto"
                 Text="PyBro Console v1.0 - Ready..."/>
    </Grid>
</Window>
